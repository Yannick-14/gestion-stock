# Force LF line endings for shell scripts (critical for Linux CI runners)
mvnw           text eol=lf
*.sh           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf

# Windows batch files keep CRLF
*.cmd          text eol=crlf
*.bat          text eol=crlf

# Java / XML / properties — normalize to LF
*.java         text eol=lf
*.xml          text eol=lf
*.properties   text eol=lf
*.md           text eol=lf

# Binaries — no line ending conversion
*.jar          binary
*.png          binary
*.jpg          binary
*.gif          binary
*.ico          binary
